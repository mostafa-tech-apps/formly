{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://formly.fly.dev/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
