{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://formly-4gbd.onrender.com/api/$1"
        },
        {
            "source": "/mcp",
            "destination": "https://formly-4gbd.onrender.com/mcp"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "https://formly-4gbd.onrender.com/uploads/$1"
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
